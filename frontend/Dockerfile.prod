# --- 1) ビルドステージ ---
  FROM node:18-alpine as build

  WORKDIR /usr/src/app/frontend
  
  COPY package*.json ./
  RUN npm install
  
  COPY . .
  
  # 本番ビルド
  RUN npm run build
  
  # --- 2) 本番ステージ (配信ステージ) ---
  FROM node:18-alpine as serve
  
  WORKDIR /usr/src/app/frontend
  
  # 静的ファイル配信用に serve をインストール (or npm i -g serve)
  RUN npm install -g serve
  
  # ビルド成果物(dist/)をコピー
  COPY --from=build /usr/src/app/frontend/dist dist
  
  # ポート3000で配信
  EXPOSE 3000
  
  # "serve" コマンドで dist をホスティング
  CMD ["serve", "-s", "dist"]
  