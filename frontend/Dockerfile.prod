# ----------------------------
# 1) ビルドステージ
# ----------------------------
  FROM node:18-alpine AS build

  WORKDIR /usr/src/app/frontend
  
  # 1-1. package*.json & package-lock.json
  COPY package*.json ./
  COPY package-lock.json ./
  
  # 1-2. npm ci (devDependencies含む)
  # ※ production buildでもVite等のdevDependenciesが必要
  RUN npm ci --production=false
  
  # 1-3. ソースコードコピー
  COPY . .
  
  # 1-4. 本番ビルド (distを生成)
  RUN npm run build
  
  
  # ----------------------------
  # 2) 本番ステージ (配信ステージ)
  # ----------------------------
  FROM node:18-alpine AS serve
  
  WORKDIR /usr/src/app/frontend
  
  # 2-1. 静的ファイル配信用に serve をグローバルインストール
  RUN npm install -g serve
  
  # 2-2. ビルド成果物(dist/)をコピー
  COPY --from=build /usr/src/app/frontend/dist dist
  
  # 2-3. ポート3000で配信
  EXPOSE 3000
  
  # 2-4. "serve" コマンドで dist をホスティング
  CMD ["serve", "-s", "dist"]
  